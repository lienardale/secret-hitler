{
  "name": "@sh/web",
  "version": "0.1.0",
  "private": true,
  "description": "Website: pages, accounts, lobby, rules, credits and moderation.",
  "license": "CC-BY-NC-SA-4.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "bash scripts/vercel-build.sh",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:integration": "vitest run --project integration",
    "e2e": "playwright test",
    "postinstall": "prisma generate",
    "db:up": "docker compose -f ../../docker-compose.yml up -d --wait && npm run db:migrate && npm run db:migrate:test",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:test": "tsx tests/_db/migrate-test-db.ts",
    "db:seed": "prisma db seed",
    "admin:grant": "tsx scripts/admin-grant.ts"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sh/engine": "*",
    "@sh/protocol": "*",
    "bcryptjs": "3.0.3",
    "jose": "6.2.13",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "partysocket": "1.3.0",
    "pg": "8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dotenv": "17.4.2",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3"
  }
}
