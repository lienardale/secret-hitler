/**
 * Generates the ticket key pair and the two HMAC secrets.
 *
 *   npm run dev:setup            write apps/rooms/.dev.vars and apps/web/.env.local
 *                                (only keys that are missing; existing values are kept)
 *   npm run dev:setup -- --print print a fresh set for a deployed environment
 *                                (rooms: `wrangler secret put`, web: Vercel env vars)
 *
 * The website keeps the private key (it signs room tickets); the rooms Worker
 * only gets the public key. Both files are gitignored.
 */
import { existsSync, readFileSync, writeFileSync } from "node:fs";
import { randomBytes } from "node:crypto";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

import { exportJWK, generateKeyPair } from "jose";

const root = join(dirname(fileURLToPath(import.meta.url)), "..");
const ROOMS_VARS = join(root, "apps/rooms/.dev.vars");
const WEB_ENV = join(root, "apps/web/.env.local");

async function freshValues() {
  const { publicKey, privateKey } = await generateKeyPair("Ed25519", { extractable: true });
  return {
    publicJwk: JSON.stringify(await exportJWK(publicKey)),
    privateJwk: JSON.stringify(await exportJWK(privateKey)),
    webToRooms: randomBytes(32).toString("base64url"),
    roomsToWeb: randomBytes(32).toString("base64url"),
  };
}

function readEnv(path: string): Map<string, string> {
  const values = new Map<string, string>();
  if (!existsSync(path)) return values;
  for (const line of readFileSync(path, "utf8").split("\n")) {
    const match = /^([A-Z0-9_]+)=(.*)$/.exec(line.trim());
    if (match) values.set(match[1] as string, (match[2] as string).replace(/^'(.*)'$/, "$1"));
  }
  return values;
}

/** Appends the missing keys; never rewrites a value that is already there. */
function fill(path: string, wanted: Record<string, string>, header: string): string[] {
  const existing = readEnv(path);
  const missing = Object.entries(wanted).filter(([key]) => !existing.has(key));
  if (missing.length === 0) return [];
  const prefix = existsSync(path)
    ? readFileSync(path, "utf8").replace(/\n*$/, "\n")
    : `${header}\n`;
  const lines = missing.map(([key, value]) => `${key}='${value}'`);
  writeFileSync(path, `${prefix}${lines.join("\n")}\n`, { mode: 0o600 });
  return missing.map(([key]) => key);
}

async function main(): Promise<void> {
  const fresh = await freshValues();

  if (process.argv.includes("--print")) {
    console.log("# rooms Worker secrets (wrangler secret put <NAME>)");
    console.log(`TICKET_PUBLIC_JWK=${fresh.publicJwk}`);
    console.log(`WEB_TO_ROOMS_SECRET=${fresh.webToRooms}`);
    console.log(`ROOMS_TO_WEB_SECRET=${fresh.roomsToWeb}`);
    console.log("\n# website env (Vercel), same secrets plus the private key");
    console.log(`TICKET_PRIVATE_JWK=${fresh.privateJwk}`);
    return;
  }

  // Reuse whatever half already exists so the two files always agree.
  const rooms = readEnv(ROOMS_VARS);
  const web = readEnv(WEB_ENV);
  const webToRooms =
    rooms.get("WEB_TO_ROOMS_SECRET") ?? web.get("WEB_TO_ROOMS_SECRET") ?? fresh.webToRooms;
  const roomsToWeb =
    rooms.get("ROOMS_TO_WEB_SECRET") ?? web.get("ROOMS_TO_WEB_SECRET") ?? fresh.roomsToWeb;
  const keysExist = rooms.has("TICKET_PUBLIC_JWK") || web.has("TICKET_PRIVATE_JWK");
  if (keysExist && !(rooms.has("TICKET_PUBLIC_JWK") && web.has("TICKET_PRIVATE_JWK"))) {
    throw new Error(
      "Only one half of the ticket key pair exists. Remove TICKET_PUBLIC_JWK from apps/rooms/.dev.vars " +
        "and TICKET_PRIVATE_JWK from apps/web/.env.local, then run this again.",
    );
  }

  const roomsAdded = fill(
    ROOMS_VARS,
    {
      TICKET_PUBLIC_JWK: fresh.publicJwk,
      WEB_TO_ROOMS_SECRET: webToRooms,
      ROOMS_TO_WEB_SECRET: roomsToWeb,
    },
    "# Local secrets for `wrangler dev` (generated by npm run dev:setup, gitignored)",
  );
  const webAdded = fill(
    WEB_ENV,
    {
      TICKET_PRIVATE_JWK: fresh.privateJwk,
      WEB_TO_ROOMS_SECRET: webToRooms,
      ROOMS_TO_WEB_SECRET: roomsToWeb,
      ROOMS_URL: "http://localhost:8787",
    },
    "# Local env for the website (generated by npm run dev:setup, gitignored)",
  );
  console.log(
    `apps/rooms/.dev.vars: ${roomsAdded.length ? `added ${roomsAdded.join(", ")}` : "up to date"}`,
  );
  console.log(
    `apps/web/.env.local: ${webAdded.length ? `added ${webAdded.join(", ")}` : "up to date"}`,
  );
}

await main();
